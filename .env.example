# Copy to .env and fill in. Never commit .env.

# Directory (tenant) ID, and the client ID of your Entra app registration
TENANT_ID=
CLIENT_ID=

# delegated (recommended: Purview's audit log shows the real person) or app
AUTH_MODE=delegated

# App mode only: a client secret, OR a certificate (PEM with private key) plus its thumbprint
CLIENT_SECRET=
CERT_PATH=
CERT_THUMBPRINT=

# Optional: remember delegated sign-ins between runs. The file holds refresh tokens; protect it.
TOKEN_CACHE_PATH=

# Optional overrides
# GRAPH_BASE=https://graph.microsoft.com/v1.0
# EDISCOVERY_DOWNLOAD_APP_ID=b26e684c-5068-4120-a679-64a5d2c909d9
# SEARCHTRAIL_STATE_DIR=.searchtrail
