# The web service: the built frontend, and /api passed to the api service on the same origin.
{
	# No admin endpoint and no saved copy of the config: it only changes with the image.
	admin off
	persist_config off
	# Plain HTTP inside the compose network. TLS and HSTS come with the install guide (PR 21).
	auto_https off
}

:8080 {
	# The API, unchanged: path, method, body and the API's own headers (it sets its own security
	# headers, so none are added here). Responses stream through, so large downloads aren't buffered.
	@api path /api /api/*
	handle @api {
		reverse_proxy api:8000
	}

	# The app. Baseline headers on these responses only. The CSP is a first version that PR 21 hardens
	# and tests; scripts, styles and fonts are all self-hosted, so 'self' is enough.
	handle {
		root * /srv
		encode zstd gzip
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			X-Frame-Options DENY
			Content-Security-Policy "default-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
			-Server
		}
		# Hashed file names never change, so they're cached for a year; a missing one is a 404.
		handle /assets/* {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		# Any other path is a client-side route: serve index.html, checked again on every load.
		handle {
			header Cache-Control no-cache
			try_files {path} /index.html
			file_server
		}
	}
}
