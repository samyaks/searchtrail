# Build context for Dockerfile.web (the repository root): the frontend and the Caddyfile, and nothing else.
*
!frontend
!deploy/Caddyfile

# Inside frontend/: what isn't a build input. Anything not listed is copied, so a new build input
# needs no change here.
frontend/node_modules
frontend/dist
frontend/coverage
frontend/tests
frontend/playwright.config.ts
frontend/eslint.config.js
frontend/scripts
frontend/*.tsbuildinfo
