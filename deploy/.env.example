# Copy to deploy/.env and adjust. Never commit .env. docker compose reads it automatically.

# Offline mode: 1 = no Microsoft tenant is contacted (DryRunTransport answers every call).
SEARCHTRAIL_DRY_RUN=1

# Postgres (the compose file runs it; change the password for anything but a laptop)
POSTGRES_USER=searchtrail
POSTGRES_PASSWORD=change-me
POSTGRES_DB=searchtrail

# Ports published on the host
API_PORT=8000
WEB_PORT=5173

# Live mode only (WS-C wires these up). Never put real values in a committed file.
# SEARCHTRAIL_TENANT_ID=
# SEARCHTRAIL_CLIENT_ID=
# SEARCHTRAIL_CLIENT_SECRET=
# SEARCHTRAIL_SESSION_SECRET=
# SEARCHTRAIL_TOKEN_ENCRYPTION_KEY=
