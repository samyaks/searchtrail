# Copy to deploy/.env and adjust. Never commit .env. docker compose reads it automatically.

# Offline mode: 1 = no Microsoft tenant is contacted (DryRunTransport answers every call). Dry run has
# no sign-in, so the database remembers which mode it was set up in, and SearchTrail refuses to serve
# it in the other one (a live database is never served with dry run on).
SEARCHTRAIL_DRY_RUN=1

# The interactive API docs at /api/docs: on in dry run, off in live mode unless set to 1.
# SEARCHTRAIL_API_DOCS=0
# Other origins allowed to call the API from a browser (a JSON list). None by default: the app and
# the API share one origin.
# SEARCHTRAIL_CORS_ORIGINS=["https://searchtrail.contoso.com"]

# Postgres (the compose file runs it; change the password for anything but a laptop)
POSTGRES_USER=searchtrail
POSTGRES_PASSWORD=change-me
POSTGRES_DB=searchtrail

# Ports published on the host: the API on its own, and the web app (which also serves /api)
API_PORT=8000
WEB_PORT=5173

# Live mode only (WS-C wires these up). Never put real values in a committed file.
# SEARCHTRAIL_TENANT_ID=
# SEARCHTRAIL_CLIENT_ID=
# SEARCHTRAIL_CLIENT_SECRET=
# SEARCHTRAIL_SESSION_SECRET=
# SEARCHTRAIL_TOKEN_ENCRYPTION_KEY=
