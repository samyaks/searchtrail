# syntax=docker/dockerfile:1
# One image for the API, the worker and migrations (they share the codebase; the command differs).
# Build: docker build -f deploy/Dockerfile.backend backend
#
# Behind a TLS-inspecting proxy, pass its CA bundle (system roots plus the proxy's CA) as a
# build secret; it is used only while installing packages and is not kept in the image:
#   docker build --secret id=extra_ca,src=/path/to/ca-bundle.crt -f deploy/Dockerfile.backend backend
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app

# Dependencies first, so code changes don't reinstall them.
COPY pyproject.toml ./
RUN --mount=type=secret,id=extra_ca,required=false \
    if [ -s /run/secrets/extra_ca ]; then export PIP_CERT=/run/secrets/extra_ca; fi \
    && mkdir -p searchtrail app && touch searchtrail/__init__.py app/__init__.py \
    && pip install . && pip uninstall -y searchtrail

COPY . .
RUN --mount=type=secret,id=extra_ca,required=false \
    if [ -s /run/secrets/extra_ca ]; then export PIP_CERT=/run/secrets/extra_ca; fi \
    && pip install --no-deps . \
    && useradd --system --uid 10001 --home /app searchtrail \
    && mkdir -p /data/storage && chown -R searchtrail /data
USER searchtrail
ENV SEARCHTRAIL_STORAGE_DIR=/data/storage
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
