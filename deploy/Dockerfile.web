# syntax=docker/dockerfile:1
# The web image: the built frontend served by Caddy, which also passes /api to the api service, so
# the browser and the API share one origin (the API allows no other origin by default).
# Build from the repository root (Dockerfile.web.dockerignore keeps the context to frontend/ and the Caddyfile):
#   docker build -f deploy/Dockerfile.web .
#
# Behind a TLS-inspecting proxy, pass its CA bundle as a build secret, as for the backend image; it is
# used only by npm ci and is not kept in the image:
#   docker build --secret id=extra_ca,src=/path/to/ca-bundle.crt -f deploy/Dockerfile.web .

# Base images are pinned by digest (the multi-arch index, so arm64 works too). To update one:
#   docker buildx imagetools inspect <tag>   and copy the top-level Digest.
FROM node:22-alpine@sha256:1314fb30ec37592d5845e5a160d522c0e680972aa534549940b8d73bde88481a AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=secret,id=extra_ca,required=false \
    if [ -s /run/secrets/extra_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/extra_ca; fi \
    && npm ci --no-audit --no-fund
# The rest of the frontend. Dockerfile.web.dockerignore lists what stays out, so a new build input
# is picked up without changing this file.
COPY frontend ./
# The production build ships no mock code (the MSW worker is served by the dev server only, see
# vite.config.ts, and src/main.tsx starts it only when import.meta.env.DEV). A safety net: fail the
# image build if a worker file, or code that refers to one, turns up in dist.
RUN npm run build \
    && if [ -n "$(find dist -iname 'mockServiceWorker*')" ] || grep -rqi mockServiceWorker dist; then \
         echo "MSW worker or code found in the production build" >&2; exit 1; fi

FROM caddy:2.11-alpine@sha256:003a97808e781aa9f7e75cc2f43d34d461099031faf5e20faefb9f61126836f0
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
RUN adduser -S -D -H -u 10001 searchtrail
USER searchtrail
EXPOSE 8080
